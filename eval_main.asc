#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <fstream>
#include <string>
#include <vector>

#include "acl/acl.h"
#include "data_utils.h"

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#include "kernel.asc"

static void PrintUsage()
{
    std::fprintf(stderr,
        "Usage: rotary_pos_emb_eval --b B --s S --h H --dim D "
        "--dtype float32|float16 --theta T --input_x X "
        "--input_pos P --output_y Y\n");
}

static bool ReadBinary(const std::string& path, std::vector<uint8_t>& data)
{
    std::ifstream file(path.c_str(), std::ios::binary | std::ios::ate);
    if (!file) {
        return false;
    }
    const std::streamsize size = file.tellg();
    if (size != static_cast<std::streamsize>(data.size())) {
        return false;
    }
    file.seekg(0, std::ios::beg);
    return static_cast<bool>(file.read(reinterpret_cast<char*>(data.data()), size));
}

static bool WriteBinary(const std::string& path, const std::vector<uint8_t>& data)
{
    std::ofstream file(path.c_str(), std::ios::binary | std::ios::trunc);
    if (!file) {
        return false;
    }
    file.write(reinterpret_cast<const char*>(data.data()),
        static_cast<std::streamsize>(data.size()));
    return static_cast<bool>(file);
}

static bool GetArg(int argc, char** argv, const char* name, std::string& value)
{
    for (int i = 1; i + 1 < argc; ++i) {
        if (std::strcmp(argv[i], name) == 0) {
            value = argv[i + 1];
            return true;
        }
    }
    return false;
}

#define ACL_CHECK(expr) do { \
    aclError _ret = (expr); \
    if (_ret != ACL_SUCCESS) { \
        std::fprintf(stderr, "ACL failure: %s ret=%d\n", #expr, static_cast<int>(_ret)); \
        return 1; \
    } \
} while (0)

int main(int argc, char** argv)
{
    std::string bText, sText, hText, dimText, dtype, thetaText;
    std::string inputXPath, inputPosPath, outputYPath;
    if (!GetArg(argc, argv, "--b", bText) ||
        !GetArg(argc, argv, "--s", sText) ||
        !GetArg(argc, argv, "--h", hText) ||
        !GetArg(argc, argv, "--dim", dimText) ||
        !GetArg(argc, argv, "--dtype", dtype) ||
        !GetArg(argc, argv, "--theta", thetaText) ||
        !GetArg(argc, argv, "--input_x", inputXPath) ||
        !GetArg(argc, argv, "--input_pos", inputPosPath) ||
        !GetArg(argc, argv, "--output_y", outputYPath)) {
        PrintUsage();
        return 1;
    }

    const uint64_t batch = std::strtoull(bText.c_str(), nullptr, 10);
    const uint64_t seq = std::strtoull(sText.c_str(), nullptr, 10);
    const uint64_t heads = std::strtoull(hText.c_str(), nullptr, 10);
    const uint64_t dim = std::strtoull(dimText.c_str(), nullptr, 10);
    const float theta = static_cast<float>(std::strtod(thetaText.c_str(), nullptr));
    const bool isHalf = dtype == "float16";
    const bool isFloat = dtype == "float32";
    if (batch == 0 || seq == 0 || heads == 0 || dim == 0 || (dim & 1U) != 0 ||
        (!isHalf && !isFloat) || theta <= 0.0f) {
        std::fprintf(stderr, "Invalid shape, dtype, or theta\n");
        return 1;
    }

    const uint64_t xElements = batch * seq * heads * dim;
    const uint64_t positionElements = batch * seq;
    const size_t elementBytes = isHalf ? sizeof(uint16_t) : sizeof(float);
    const size_t xBytes = static_cast<size_t>(xElements * elementBytes);
    const size_t positionBytes = static_cast<size_t>(positionElements * sizeof(int32_t));

    std::vector<uint8_t> hostX(xBytes);
    std::vector<uint8_t> hostPositions(positionBytes);
    std::vector<uint8_t> hostY(xBytes);
    if (!ReadBinary(inputXPath, hostX) || !ReadBinary(inputPosPath, hostPositions)) {
        std::fprintf(stderr, "Input size or file read failure\n");
        return 1;
    }

    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(0));
    aclrtStream stream = nullptr;
    ACL_CHECK(aclrtCreateStream(&stream));

    uint8_t* deviceX = nullptr;
    uint8_t* devicePositions = nullptr;
    uint8_t* deviceY = nullptr;
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&deviceX), xBytes,
        ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&devicePositions), positionBytes,
        ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(reinterpret_cast<void**>(&deviceY), xBytes,
        ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMemcpy(deviceX, xBytes, hostX.data(), xBytes,
        ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMemcpy(devicePositions, positionBytes, hostPositions.data(), positionBytes,
        ACL_MEMCPY_HOST_TO_DEVICE));

    const int64_t xShape[] = {
        static_cast<int64_t>(batch), static_cast<int64_t>(seq),
        static_cast<int64_t>(heads), static_cast<int64_t>(dim)};
    const int64_t positionShape[] = {
        static_cast<int64_t>(batch), static_cast<int64_t>(seq)};
    TensorInfo xTensor[] = {{xShape, 4, isHalf ? 1 : 0}};
    TensorInfo positionTensor[] = {{positionShape, 2, 5}};
    TensorInfo yTensor[] = {{xShape, 4, isHalf ? 1 : 0}};
    TensorGroupInfo xInfo = {xTensor, 1};
    TensorGroupInfo positionInfo = {positionTensor, 1};
    TensorGroupInfo yInfo = {yTensor, 1};

    int64_t coreCount = 0;
    ACL_CHECK(aclrtGetDeviceInfo(0, ACL_DEV_ATTR_VECTOR_CORE_NUM, &coreCount));
    run_kernel(reinterpret_cast<GM_ADDR>(deviceX), xInfo,
        reinterpret_cast<GM_ADDR>(devicePositions), positionInfo,
        reinterpret_cast<GM_ADDR>(deviceY), yInfo, coreCount, stream, theta);
    ACL_CHECK(aclrtSynchronizeStream(stream));
    ACL_CHECK(aclrtMemcpy(hostY.data(), xBytes, deviceY, xBytes,
        ACL_MEMCPY_DEVICE_TO_HOST));

    const bool writeOk = WriteBinary(outputYPath, hostY);
    aclrtFree(deviceX);
    aclrtFree(devicePositions);
    aclrtFree(deviceY);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    if (!writeOk) {
        std::fprintf(stderr, "Output write failure\n");
        return 1;
    }
    return 0;
}
