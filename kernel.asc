#include "kernel_operator.h"

#ifdef ROPE_USE_CAST_ROUND
#define ROPE_FP16_OUTPUT_ROUND_MODE AscendC::RoundMode::CAST_ROUND
#else
#define ROPE_FP16_OUTPUT_ROUND_MODE AscendC::RoundMode::CAST_RINT
#endif

#ifdef ROPE_REDUCE_ANGLE
constexpr float ROPE_TWO_PI = 6.28318530717958647692f;
constexpr float ROPE_INV_TWO_PI = 0.15915494309189533577f;
#endif

// This file is included by main.asc. It must not define main(), TensorInfo, or
// TensorGroupInfo; those symbols belong to the host harness.

struct RotaryPosEmbTilingData {
    uint64_t batch;
    uint64_t seq;
    uint64_t heads;
    uint64_t dim;
    uint64_t rows;
    float theta;
    float logTheta;
};

template <typename InputT, bool IS_HALF>
class KernelRotaryPosEmb {
public:
    __aicore__ inline KernelRotaryPosEmb(AscendC::TPipe* pipe, const RotaryPosEmbTilingData& tiling)
        : pipe_(pipe), tiling_(tiling)
    {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR positions, GM_ADDR y)
    {
        const uint32_t dim = static_cast<uint32_t>(tiling_.dim);
        halfDim_ = dim / 2;
        // Level-2 vector APIs execute complete vector repeats. Reserve the
        // full final repeat, not only the valid element count.
        constexpr uint32_t floatElementsPerVector = 64U;
        constexpr uint32_t inputElementsPerVector =
            IS_HALF ? 128U : floatElementsPerVector;
        halfStorageElems_ =
            (halfDim_ + inputElementsPerVector - 1U)
            / inputElementsPerVector * inputElementsPerVector;
        floatStorageElems_ =
            (halfDim_ + floatElementsPerVector - 1U)
            / floatElementsPerVector * floatElementsPerVector;
        const uint32_t rowStorageElems = 2U * halfStorageElems_;

        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ InputT*>(x), tiling_.rows * tiling_.dim);
        positionsGm_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(positions),
            tiling_.batch * tiling_.seq);
        yGm_.SetGlobalBuffer(reinterpret_cast<__gm__ InputT*>(y), tiling_.rows * tiling_.dim);

        // The two logical halves are separated by halfStorageElems_.  This
        // stride is a multiple of 32 bytes for both FP16 and FP32, so every
        // vector operand starts at a valid UB alignment even when dim is not
        // itself 32-byte aligned.
        pipe_->InitBuffer(inQueueX_, 1, rowStorageElems * sizeof(InputT));
        pipe_->InitBuffer(inQueuePos_, 1, 32);
        pipe_->InitBuffer(outQueueY_, 1, rowStorageElems * sizeof(InputT));

        pipe_->InitBuffer(xFloatBuf_, 2U * floatStorageElems_ * sizeof(float));
        pipe_->InitBuffer(yFloatBuf_, 2U * floatStorageElems_ * sizeof(float));
        pipe_->InitBuffer(freqBuf_, floatStorageElems_ * sizeof(float));
        pipe_->InitBuffer(exponentBuf_, floatStorageElems_ * sizeof(float));
        pipe_->InitBuffer(scaledLogBuf_, floatStorageElems_ * sizeof(float));
        pipe_->InitBuffer(angleBuf_, floatStorageElems_ * sizeof(float));
        pipe_->InitBuffer(cosBuf_, floatStorageElems_ * sizeof(float));
        pipe_->InitBuffer(sinBuf_, floatStorageElems_ * sizeof(float));
        pipe_->InitBuffer(tmp0Buf_, floatStorageElems_ * sizeof(float));
        pipe_->InitBuffer(tmp1Buf_, floatStorageElems_ * sizeof(float));
        pipe_->InitBuffer(positionBuf_, 32);
    }

    __aicore__ inline void Process()
    {
        BuildInverseFrequency();

        const uint64_t blockIdx = static_cast<uint64_t>(AscendC::GetBlockIdx());
        const uint64_t blockNum = static_cast<uint64_t>(AscendC::GetBlockNum());
        const uint64_t dim = tiling_.dim;
        const uint64_t headCount = tiling_.heads;

        // A strided row assignment keeps every core's output range disjoint and
        // handles totalRows < blockNum without a special tail kernel.
        for (uint64_t row = blockIdx; row < tiling_.rows; row += blockNum) {
            const uint64_t positionRow = row / headCount;
            CopyIn(row * dim, positionRow);
            Compute();
            CopyOut(row * dim);
        }
    }

private:
    __aicore__ inline void CopyIn(uint64_t xOffset, uint64_t positionOffset)
    {
        AscendC::LocalTensor<InputT> xLocal = inQueueX_.AllocTensor<InputT>();
        AscendC::DataCopyPad(xLocal, xGm_[xOffset],
            {1, static_cast<uint16_t>(halfDim_ * sizeof(InputT)), 0, 0},
            {false, 0, 0, 0});
        AscendC::DataCopyPad(xLocal[halfStorageElems_], xGm_[xOffset + halfDim_],
            {1, static_cast<uint16_t>(halfDim_ * sizeof(InputT)), 0, 0},
            {false, 0, 0, 0});
        inQueueX_.EnQue(xLocal);

        AscendC::LocalTensor<int32_t> positionLocal = inQueuePos_.AllocTensor<int32_t>();
        AscendC::DataCopyPad(positionLocal, positionsGm_[positionOffset],
            {1, static_cast<uint16_t>(sizeof(int32_t)), 0, 0},
            {false, 0, 0, 0});
        inQueuePos_.EnQue(positionLocal);
    }

    __aicore__ inline void BuildInverseFrequency()
    {
        const int32_t dim = static_cast<int32_t>(tiling_.dim);
        const int32_t halfDim = static_cast<int32_t>(halfDim_);

        AscendC::LocalTensor<float> exponent = exponentBuf_.Get<float>();
        for (int32_t i = 0; i < halfDim; ++i) {
            // The metadata vector is built on device; the subsequent power is
            // evaluated in FP32 by the Ascend C vector math APIs.
            // Keep the reference's FP32 arange(i) / dim intermediate before
            // applying the factor two.
            exponent.SetValue(i, 2.0f * (static_cast<float>(i) / static_cast<float>(dim)));
        }
        // SetValue is a scalar-side write; make the metadata visible to the
        // following vector math instructions.
        AscendC::PipeBarrier<PIPE_ALL>();

        AscendC::LocalTensor<float> scaledLog = scaledLogBuf_.Get<float>();
        AscendC::LocalTensor<float> inverseFrequency = freqBuf_.Get<float>();
        AscendC::Muls(scaledLog, exponent, -tiling_.logTheta, halfDim);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Exp<float, 10>(inverseFrequency, scaledLog, halfDim);
    }

    __aicore__ inline void Compute()
    {
        const uint32_t halfDim = halfDim_;

        AscendC::LocalTensor<InputT> xLocal = inQueueX_.DeQue<InputT>();
        AscendC::LocalTensor<int32_t> positionLocal = inQueuePos_.DeQue<int32_t>();
        AscendC::LocalTensor<InputT> yLocal = outQueueY_.AllocTensor<InputT>();

        AscendC::LocalTensor<float> positionFloat = positionBuf_.Get<float>();
        AscendC::Cast<float, int32_t>(positionFloat, positionLocal,
            AscendC::RoundMode::CAST_NONE, 1);
        AscendC::PipeBarrier<PIPE_ALL>();
        float position = positionFloat.GetValue(0);

        if constexpr (IS_HALF) {
            AscendC::LocalTensor<float> xFloat = xFloatBuf_.Get<float>();
            AscendC::LocalTensor<float> yFloat = yFloatBuf_.Get<float>();
            AscendC::Cast<float, half>(xFloat, xLocal,
                AscendC::RoundMode::CAST_NONE, halfDim);
            AscendC::Cast<float, half>(xFloat[floatStorageElems_], xLocal[halfStorageElems_],
                AscendC::RoundMode::CAST_NONE, halfDim);
            AscendC::PipeBarrier<PIPE_V>();
            ComputeFloat(xFloat, yFloat, position, halfDim, floatStorageElems_);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Cast<half, float>(yLocal, yFloat,
                ROPE_FP16_OUTPUT_ROUND_MODE, halfDim);
            AscendC::Cast<half, float>(yLocal[halfStorageElems_], yFloat[floatStorageElems_],
                ROPE_FP16_OUTPUT_ROUND_MODE, halfDim);
        } else {
            ComputeFloat(xLocal, yLocal, position, halfDim, halfStorageElems_);
        }

        outQueueY_.EnQue(yLocal);
        inQueueX_.FreeTensor(xLocal);
        inQueuePos_.FreeTensor(positionLocal);
    }

    __aicore__ inline void ComputeFloat(AscendC::LocalTensor<float> xLocal,
                                        AscendC::LocalTensor<float> yLocal,
                                        float position,
                                        uint32_t halfDim,
                                        uint32_t halfStride)
    {
        AscendC::LocalTensor<float> angle = angleBuf_.Get<float>();
        AscendC::LocalTensor<float> cosine = cosBuf_.Get<float>();
        AscendC::LocalTensor<float> sine = sinBuf_.Get<float>();
        AscendC::LocalTensor<float> tmp0 = tmp0Buf_.Get<float>();
        AscendC::LocalTensor<float> tmp1 = tmp1Buf_.Get<float>();
        AscendC::LocalTensor<float> inverseFrequency = freqBuf_.Get<float>();

        AscendC::Muls(angle, inverseFrequency, position, halfDim);
        AscendC::PipeBarrier<PIPE_V>();
#ifdef ROPE_REDUCE_ANGLE
        // Diagnostic path: Cos/Sin lose accuracy for the large raw angles
        // reached by high positions. Positions are non-negative by the op
        // contract, so a floor-based remainder is valid and deterministic.
        for (uint32_t i = 0; i < halfDim; ++i) {
            const float rawAngle = angle.GetValue(i);
            // Positions are non-negative, so conversion after +0.5 is the
            // nearest-integer turn count and does not require libm floorf.
            const int32_t turns = static_cast<int32_t>(
                rawAngle * ROPE_INV_TWO_PI + 0.5f);
            angle.SetValue(i, rawAngle - static_cast<float>(turns) * ROPE_TWO_PI);
        }
        AscendC::PipeBarrier<PIPE_ALL>();
#endif
        AscendC::Cos(cosine, angle, halfDim);
        AscendC::Sin(sine, angle, halfDim);
        AscendC::PipeBarrier<PIPE_V>();

        AscendC::Mul(tmp0, xLocal, cosine, halfDim);
        AscendC::Mul(tmp1, xLocal[halfStride], sine, halfDim);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Sub(yLocal, tmp0, tmp1, halfDim);
        AscendC::PipeBarrier<PIPE_V>();

        AscendC::Mul(tmp0, xLocal[halfStride], cosine, halfDim);
        AscendC::Mul(tmp1, xLocal, sine, halfDim);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Add(yLocal[halfStride], tmp0, tmp1, halfDim);
    }

    __aicore__ inline void CopyOut(uint64_t yOffset)
    {
        AscendC::LocalTensor<InputT> yLocal = outQueueY_.DeQue<InputT>();
        AscendC::DataCopyPad(yGm_[yOffset], yLocal,
            {1, static_cast<uint16_t>(halfDim_ * sizeof(InputT)), 0, 0});
        AscendC::DataCopyPad(yGm_[yOffset + halfDim_], yLocal[halfStorageElems_],
            {1, static_cast<uint16_t>(halfDim_ * sizeof(InputT)), 0, 0});
        outQueueY_.FreeTensor(yLocal);
    }

private:
    AscendC::TPipe* pipe_;
    RotaryPosEmbTilingData tiling_;

    AscendC::GlobalTensor<InputT> xGm_;
    AscendC::GlobalTensor<int32_t> positionsGm_;
    AscendC::GlobalTensor<InputT> yGm_;

    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueX_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueuePos_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueY_;

    AscendC::TBuf<AscendC::TPosition::VECCALC> xFloatBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> yFloatBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> freqBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> exponentBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> scaledLogBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> angleBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> cosBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> sinBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmp0Buf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tmp1Buf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> positionBuf_;

    uint32_t halfDim_;
    uint32_t halfStorageElems_;
    uint32_t floatStorageElems_;
};

extern "C" __global__ __vector__ void rotary_pos_emb_fp32(
    GM_ADDR x, GM_ADDR positions, GM_ADDR y, RotaryPosEmbTilingData tiling)
{
    AscendC::TPipe pipe;
    KernelRotaryPosEmb<float, false> op(&pipe, tiling);
    op.Init(x, positions, y);
    op.Process();
}

extern "C" __global__ __vector__ void rotary_pos_emb_fp16(
    GM_ADDR x, GM_ADDR positions, GM_ADDR y, RotaryPosEmbTilingData tiling)
{
    AscendC::TPipe pipe;
    KernelRotaryPosEmb<half, true> op(&pipe, tiling);
    op.Init(x, positions, y);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
    GM_ADDR positions, const TensorGroupInfo& info_positions,
    GM_ADDR y, const TensorGroupInfo& info_y, int64_t availableCoreNum,
    aclrtStream stream, float theta)
{
    if (info_x.numTensors < 1 || info_positions.numTensors < 1 || info_y.numTensors < 1 ||
        info_x.tensors == nullptr || info_positions.tensors == nullptr || info_y.tensors == nullptr ||
        availableCoreNum <= 0 || theta <= 0.0f) {
        return;
    }

    const TensorInfo& xInfo = info_x.tensors[0];
    const TensorInfo& positionsInfo = info_positions.tensors[0];
    const TensorInfo& yInfo = info_y.tensors[0];
    if (xInfo.shape == nullptr || positionsInfo.shape == nullptr || yInfo.shape == nullptr ||
        xInfo.numDims != 4 || positionsInfo.numDims != 2 || yInfo.numDims != 4) {
        return;
    }

    const int64_t batch = xInfo.shape[0];
    const int64_t seq = xInfo.shape[1];
    const int64_t heads = xInfo.shape[2];
    const int64_t dim = xInfo.shape[3];
    if (batch <= 0 || seq <= 0 || heads <= 0 || dim <= 0 || (dim & 1) != 0 ||
        positionsInfo.shape[0] != batch || positionsInfo.shape[1] != seq ||
        yInfo.shape[0] != batch || yInfo.shape[1] != seq ||
        yInfo.shape[2] != heads || yInfo.shape[3] != dim) {
        return;
    }

    RotaryPosEmbTilingData tiling;
    tiling.batch = static_cast<uint64_t>(batch);
    tiling.seq = static_cast<uint64_t>(seq);
    tiling.heads = static_cast<uint64_t>(heads);
    tiling.dim = static_cast<uint64_t>(dim);
    tiling.rows = tiling.batch * tiling.seq * tiling.heads;
    tiling.theta = theta;
    tiling.logTheta = __builtin_logf(theta);

    const uint64_t maxBlocks = static_cast<uint64_t>(availableCoreNum);
    const uint32_t blockNum = static_cast<uint32_t>(tiling.rows < maxBlocks ? tiling.rows : maxBlocks);
    if (blockNum == 0) {
        return;
    }

    if (xInfo.dtype == 0 && yInfo.dtype == 0 && positionsInfo.dtype == 5) {
        rotary_pos_emb_fp32<<<blockNum, nullptr, stream>>>(x, positions, y, tiling);
    } else if (xInfo.dtype == 1 && yInfo.dtype == 1 && positionsInfo.dtype == 5) {
        rotary_pos_emb_fp16<<<blockNum, nullptr, stream>>>(x, positions, y, tiling);
    }
}
